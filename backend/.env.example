# ===== STRATIQA Backend Environment =====
# Copy to .env and fill in real values. NEVER commit .env.

# App
STRATIQA_ENV=development
STRATIQA_DEBUG=true
STRATIQA_API_PREFIX=/api/v1
STRATIQA_CORS_ORIGINS=http://localhost:3000

# Security — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
STRATIQA_JWT_SECRET=change-me-to-a-long-random-string
STRATIQA_JWT_ALGORITHM=HS256
STRATIQA_ACCESS_TOKEN_MINUTES=30
STRATIQA_REFRESH_TOKEN_DAYS=14

# Database
STRATIQA_DATABASE_URL=postgresql+psycopg://stratiqa:stratiqa@localhost:5432/stratiqa

# Redis
STRATIQA_REDIS_URL=redis://localhost:6379/0

# Qdrant
STRATIQA_QDRANT_URL=http://localhost:6333

# AI provider gateway (provider-agnostic; leave blank to use rule-based fallback)
STRATIQA_LLM_PROVIDER=none
STRATIQA_LLM_API_KEY=
STRATIQA_LLM_MODEL=
